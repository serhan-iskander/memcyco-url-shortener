# memcyco — environment overrides for docker compose and host-side `java -jar`.
# Copy to .env (compose auto-loads it) and tweak if needed. None of these are
# required for the default local stack — they're documented to make the moving
# parts visible.

# --- Database -----------------------------------------------------------------
# Hardcoded in docker-compose.yml for the demo. Override for any real deployment.
POSTGRES_DB=memcyco
POSTGRES_USER=memcyco
POSTGRES_PASSWORD=memcyco

# JDBC URL the backend uses. Inside compose this resolves via the `postgres`
# service name; for host-side dev set to jdbc:postgresql://localhost:5432/memcyco.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/memcyco
SPRING_DATASOURCE_USERNAME=memcyco
SPRING_DATASOURCE_PASSWORD=memcyco

# --- Redis --------------------------------------------------------------------
# Service name inside compose; localhost when running the jar directly.
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# --- App ----------------------------------------------------------------------
# Base URL used when constructing the `shortUrl` field in API responses.
APP_BASE_URL=http://localhost:8080

# --- Frontend (Vite dev only) -------------------------------------------------
# Used by buildShortUrl() so the table's "open" link points at the backend
# (which serves the 302), not at the Vite dev server (which doesn't).
VITE_BACKEND_BASE_URL=http://localhost:8080

# --- Bonus: rate limit --------------------------------------------------------
APP_RATE_LIMIT_ENABLED=false
# Per-IP token bucket size when enabled.
# APP_RATE_LIMIT_REDIRECT_PER_IP_PER_MINUTE=60

# --- Bonus: geo enrichment ----------------------------------------------------
# When true the backend looks up the IP via MaxMind GeoLite2 and tags each click
# row with `country` / `city` in the JSONB `data` column. See docker/README.md
# for how to obtain and mount the .mmdb file.
APP_GEO_ENABLED=false
APP_GEO_DB_PATH=/data/GeoLite2-City.mmdb
